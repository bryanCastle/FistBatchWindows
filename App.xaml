<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PhotoOrganizer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0B0B0B" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B8B8B8" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#000000" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E8E8E8" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CFCFCF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
